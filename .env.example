# ---- Keystatic (content editor at /keystatic) ----
# Leave unset locally (edits save to files on your laptop).
# On Vercel set these so edits on the live site commit to GitHub:
NEXT_PUBLIC_KEYSTATIC_STORAGE_KIND=github
NEXT_PUBLIC_GITHUB_OWNER=your-github-username
NEXT_PUBLIC_GITHUB_REPO=portfolio
# Filled in automatically when you first open /keystatic in GitHub mode (see README):
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# ---- Contact form (Resend) ----
RESEND_API_KEY=
# Where contact-form messages are delivered:
CONTACT_TO_EMAIL=you@example.com
# Sender. Use onboarding@resend.dev until testimonyadewale.com is verified in Resend:
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://testimonyadewale.com
